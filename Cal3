def qo_shish(x, y):
    return x + y

def ayirish(x, y):
    return x - y

def ko_paytirish(x, y):
    return x * y

def bo_lish(x, y):
    if y == 0:
        return "Nolga bo'lish mumkin emas!"
    return x / y

print("=== Kalkulyator ===")
print("Amalni tanlang:")
print("1. Qo'shish (+)")
print("2. Ayirish (-)")
print("3. Ko'paytirish (*)")
print("4. Bo'lish (/)")

tanlov = input("Tanlovingiz (1/2/3/4): ")

if tanlov in ('1', '2', '3', '4'):
    try:
        num1 = float(input("Birinchi sonni kiriting: "))
        num2 = float(input("Ikkinchi sonni kiriting: "))

        if tanlov == '1':
            print(f"Natija: {num1} + {num2} = {qo_shish(num1, num2)}")
        elif tanlov == '2':
            print(f"Natija: {num1} - {num2} = {ayirish(num1, num2)}")
        elif tanlov == '3':
            print(f"Natija: {num1} * {num2} = {ko_paytirish(num1, num2)}")
        elif tanlov == '4':
            print(f"Natija: {num1} / {num2} = {bo_lish(num1, num2)}")
    except ValueError:
        print("Xatolik: Iltimos, faqat son kiriting!")
else:
    print("Noto'g'ri tanlov kiritildi!")
